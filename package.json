{
  "name": "leaf-validator",
  "version": "7.10.7",
  "description": "Declarative state progression & validation",
  "keywords": [
    "react",
    "declarative",
    "validation",
    "state management"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "repository": "https://github.com/stewie1570/leaf-validator",
  "author": "Stewart Anderson",
  "license": "MIT",
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bootstrap": "^5.3.8",
    "del-cli": "^8.0.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "node scripts/analyze.mjs --json",
    "analyze-in-browser": "node scripts/analyze.mjs",
    "start": "vite",
    "preview": "vite preview",
    "build": "vite build && npm run build-package",
    "tdd": "vitest",
    "test": "vitest run --coverage",
    "build-package": "del-cli ./dist && npm run build-cjs && npm run build-esm",
    "build-cjs": "tsc -p tsconfig.cjs.json",
    "build-esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\" && node scripts/fix-esm-extensions.mjs && node scripts/verify-esm.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
